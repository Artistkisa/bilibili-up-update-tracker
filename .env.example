# Docker schedule
TZ=Asia/Shanghai
CHECK_CRON=0 10 * * *

# JSON list of monitored UP users
UP_USERS_JSON=[{"uid":68559,"name":"22和33"}]

# Comma-separated enabled channels: email,webhook,gotify
NOTIFY_CHANNELS=email

EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your_email@qq.com
EMAIL_PASS=replace_with_authorization_code
EMAIL_TO=recipient@example.com

WEBHOOK_URL=
WEBHOOK_HEADERS_JSON={}
WEBHOOK_TIMEOUT=10

GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
GOTIFY_TIMEOUT=10
